{
  "_comment": "Quiver 专用工作流:生成单个道具并自动抠成透明 PNG(出图即可用,免手动 key-out)。Z-Image t2i -> RemoveBackground(本地模型) -> JoinImageWithAlpha -> SaveImage(RGBA)。API 格式,用 `comfy.py raw` 跑。⚠️ 需先在 ComfyUI 装一个抠图模型(见 README),否则节点 10 的 bg_removal_name 会报 value_not_in_list 并列出可选项。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 3.0
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "16-bit pixel art game prop, warm wood and dark iron tones, flat even neutral lighting, crisp clean pixels. A single isolated blacksmith anvil on a wooden stump, centered, front 3/4 view, plain solid flat grey background, no glow, no halo, no cast shadow, no scene, nothing else, no text."
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 768,
      "height": 768,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "seed": 20260607,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "7",
        0
      ],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "10": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "BiRefNet.safetensors"
    }
  },
  "11": {
    "class_type": "RemoveBackground",
    "inputs": {
      "image": [
        "9",
        0
      ],
      "bg_removal_model": [
        "10",
        0
      ]
    }
  },
  "12": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "9",
        0
      ],
      "alpha": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "projects/quiver/props/decor/anvil"
    }
  }
}