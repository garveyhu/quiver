{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiver",
  "mainBinaryName": "Quiver",
  "version": "0.0.0",
  "identifier": "dev.quiver.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn --cwd frontend dev",
    "beforeBuildCommand": "yarn --cwd frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quiver",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
